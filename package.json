{
  "name": "hostile-territory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:favicon": "node scripts/gen-favicon.mjs",
    "worker:dev": "npx wrangler dev -c workers/share/wrangler.jsonc --local --port 8789 --var ORIGIN:http://localhost:4173 --var NO_REPORT:1",
    "worker:deploy": "npx wrangler deploy -c workers/share/wrangler.jsonc"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@vitejs/plugin-react": "^6.0.4",
    "sharp": "^0.35.3",
    "vite": "^8.2.0",
    "workers-og": "^0.0.27",
    "wrangler": "^4.151.3"
  }
}
